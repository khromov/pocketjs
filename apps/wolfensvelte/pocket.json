{
  "$schema": "https://pocketjs.dev/schema/pocket-2.json",
  "pocket": 2,
  "id": "dev.pocket-stack.svelte.wolfensvelte",
  "name": "pocketjs-wolfensvelte",
  "title": "PocketJS: Wolfensvelte 3D",
  "version": "0.1.0",
  "engine": {
    "capabilities": {
      "requires": [
        "text.glyphs.baked",
        "input.buttons"
      ],
      "enhances": [
        "input.analog.left",
        "audio.pcm"
      ]
    }
  },
  "app": {
    "entry": "apps/wolfensvelte/main.ts",
    "output": "wolfensvelte-main",
    "framework": "svelte",
    "viewport": {
      "fixed": {
        "logical": [
          480,
          272
        ],
        "presentation": "integer-fit"
      }
    }
  }
}
